# Опрос датчиков железа. Ставится ВНУТРИ grach (там openclaw, чью живость проверяем),
# POST'ит в проксированный публичный API MOTUS на 127.0.0.1:18790.
# Код: одиночный stdlib-файл /opt/motus-probe/somatic_probe.py.
[Unit]
Description=MOTUS — опрос датчиков железа
After=network-online.target

[Service]
Type=oneshot
User=motus-probe
StateDirectory=motus-probe
Environment=MOTUS_PROBE_STATE=%S/motus-probe/prev.json
ExecStart=/usr/bin/python3 /opt/motus-probe/somatic_probe.py \
  --motusd http://127.0.0.1:18790 --openclaw-port 18789
NoNewPrivileges=yes
