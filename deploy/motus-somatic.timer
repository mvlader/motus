# Датчики железа модулируют гейны/пороги (не аффект напрямую), грубой
# гранулярности хватает; резкий фронт «openclaw лёг» probe ловит по своей памяти
# между запусками (StateDirectory).
[Unit]
Description=MOTUS — датчики железа каждые 5 минут

[Timer]
OnBootSec=2min
OnUnitActiveSec=5min
AccuracySec=30s

[Install]
WantedBy=timers.target
