# Опрашивать датчики железа раз в 5 минут. Соматический слой модулирует гейны и
# пороги (не аффект напрямую), ему грубой гранулярности хватает; резкий фронт
# (сервис лёг) probe ловит по своей памяти между запусками.
[Unit]
Description=MOTUS — опрос датчиков железа каждые 5 минут

[Timer]
OnBootSec=2min
OnUnitActiveSec=5min
AccuracySec=30s

[Install]
WantedBy=timers.target
