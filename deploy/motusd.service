# Ставится ВНУТРИ отдельного Incus-контейнера `motus` (не grach, не хост).
# Изоляция от openclaw: другой контейнер, другой user, код только на чтение,
# сырые числа — на unix-сокете, наружу не проброшенном. docs/04-model-l1.md, «Изоляция».
#
# Код: /opt/motus (owner root, чтобы motus не мог сам себя переписать).
# Состояние: /var/lib/motus (owner motus, 700).
# Публичный API: tcp:0.0.0.0:18790 — Incus proxy device на grach форвардит его
#   в grach как 127.0.0.1:18790; отдаёт только PUBLIC_PATHS, без единого числа.
# Полный API: /run/motusd/adm.sock — только внутри этого контейнера.
[Unit]
Description=MOTUS — слой мотивации (изолированный инстанс)
After=network-online.target

[Service]
Type=simple
User=motus
WorkingDirectory=/opt/motus
RuntimeDirectory=motusd
ExecStart=/usr/bin/python3 -m motus.daemon \
  --var /var/lib/motus \
  --pub-port 18790 --pub-host 0.0.0.0 \
  --admin-socket /run/motusd/adm.sock
Restart=on-failure
RestartSec=5
# L-1 и самокурирование — claude-sonnet-5 через `claude -p` (подписка Claude Code,
# бинарь /opt/claude/claude). Токен — `claude setup-token`, файл 600 root:
#   CLAUDE_CODE_OAUTH_TOKEN=...
# Нет файла — L-1 откатывается на словарь, курирование пропускает ночь.
EnvironmentFile=-/etc/motus/claude.env
Environment=HOME=/var/lib/motus
Environment=DISABLE_AUTOUPDATER=1
Environment=CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/motus
ProtectKernelTunables=yes
ProtectControlGroups=yes
# AF_INET6: api.anthropic.com отдаёт и IPv6-адреса.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
