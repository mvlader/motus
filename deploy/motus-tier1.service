# Tier 1 — исполнитель фоновых задач MOTUS. Ставится ВНУТРИ grach (там openclaw и
# рабочий каталог). Забирает одну задачу из проксированного публичного API MOTUS
# на 127.0.0.1:18790, прогоняет одним ходом `openclaw agent exec`, проверяет
# результат и шлёт /consummation.
# Код: одиночный stdlib-файл /opt/motus-tier1/tier1_executor.py.
#
# --isolated НЕ используется (2026-09-13, после того как живой прогон поймал
# реальный баг): --isolated даёт полностью пустой auth-store — ни ключа
# Anthropic (chat идёт через отдельный claude-cli login, не через него), ни
# регистрации локальных ollama-моделей. Единственный способ дать ходу рабочую
# модель — свой --config (см. deploy/tier1-exec-config.json), а --config
# несовместим с --isolated. Без --isolated agent exec получает куда больше
# инструментов (34 вместо ~11), включая conversations_send/conversations_turn/
# sessions_send — то есть буквально outbound, что нарушает главное правило
# Tier1 («фоновая задача никогда не пишет наружу»). Поэтому exec-config.json
# сам сужает набор инструментов (`agents.entries.main.tools.allow`) до
# read/write/edit/exec/memory — проверено вручную: conversations_send и
# все каналы отправки отсутствуют в получившемся наборе. web_search/web_fetch
# убраны 2026-09-15: фоновый ход без человека не должен сам тащить в себя
# недоверенный текст из сети (за 3 дня ни одного обращения — не нужны).
[Unit]
Description=MOTUS — исполнитель фоновых задач (Tier 1)
After=network-online.target

[Service]
Type=oneshot
# openclaw agent exec нужен ambient/exec-конфиг openclaw и рабочий каталог —
# проще запускать от самого openclaw, чем городить общий доступ.
User=openclaw
StateDirectory=motus-tier1
Environment=MOTUS_TIER1_STATE=%S/motus-tier1
Environment=MOTUS_TIER1_MOTUSD=http://127.0.0.1:18790
Environment=MOTUS_TIER1_CWD=/home/openclaw/.openclaw/workspace
Environment=MOTUS_TIER1_OPENCLAW=/home/openclaw/.npm-global/bin/openclaw
# --config задаёт узкий exec-конфиг (модель + разрешённые инструменты, см.
# комментарий выше и deploy/tier1-exec-config.json); --local-model-lean держит
# компактную схему инструментов для мелкой модели.
Environment="MOTUS_TIER1_OC_ARGS=--config /opt/motus-tier1/exec-config.json --local-model-lean"
# ge4b-heretic (E4B), а не g26-heretic — тот делит ПК с живым диалогом
# (см. docs/04-model-l1.md, тот же вывод уже был сделан для L-1-сенсора).
Environment=MOTUS_TIER1_MODEL=ollama/ge4b-heretic:latest
Environment=MOTUS_TIER1_TASK_TIMEOUT=420
ExecStart=/usr/bin/python3 /opt/motus-tier1/tier1_executor.py
# Фоновая работа не должна греть Pi в ущерб живому разговору и не должна
# соревноваться за CPU: низкий приоритет и потолок доли ядра.
Nice=15
CPUWeight=20
CPUQuota=60%
IOWeight=20
NoNewPrivileges=yes
TimeoutStartSec=600
# [Install] нет намеренно: сервис запускает только таймер (motus-tier1.timer).
